# .env.example — plantilla de variables de entorno.
# El .env real (con valores reales) NO se sube (está en .gitignore).
#
# Regla que sigo en este fichero: aquí solo aparecen variables que el compose
# pasa de verdad a algún contenedor. Una variable documentada que el compose no
# reenvía no hace nada, y eso es peor que no documentarla: parece que funciona.

DB_HOST=postgres
DB_PORT=5432
DB_NAME=name
DB_USER=user
DB_PASSWORD=cambiar

POSTGRES_DB=name
POSTGRES_USER=user
POSTGRES_PASSWORD=cambiar

REDIS_HOST=redis
REDIS_PORT=6379
SECRET_KEY=genera_uno_con_secrets_token_hex
SESSION_COOKIE_SECURE=false

QUEUE_REDIS_HOST=redis-queue
QUEUE_REDIS_PORT=6379

# Clave gratuita de USDA FoodData Central (https://fdc.nal.usda.gov/api-key-signup).
# Solo la necesita services/api/scripts/generate_seed.py, que se ejecuta a mano:
# la API arranca desde seed.json y no habla con USDA.
USDA_API_KEY=tu_clave_aqui

# ---------- Modelo de lenguaje (solo lo usa el worker) ----------
# Proveedor y modelo van por entorno para poder probar modelos distintos SIN
# reconstruir la imagen.
#   stub       → respuesta fija y válida, sin red y sin gastar dinero.
#   openrouter → el servicio gestionado.
LLM_PROVIDER=stub

# Identificador tal y como lo publica OpenRouter. Se ignora con LLM_PROVIDER=stub.
# deepseek/deepseek-v4-pro es el que uso; openai/gpt-4o-mini cuesta unas nueve
# veces menos por generación, para cuando solo quiero comprobar que el flujo va.
LLM_MODEL=deepseek/deepseek-v4-pro
OPENROUTER_API_KEY=tu_clave_aqui

# Cómo se le pide el JSON al modelo. No todos admiten salida estructurada: con
# los que no, la petición falla con 400 y hay que bajar a json_object.
#   json_schema | json_object | none
LLM_RESPONSE_FORMAT=json_schema

# Tope de tokens de la respuesta. Un plan semanal completo de deepseek-v4-pro
# gastó 9.529, así que 8.000 lo truncaba a mitad: el margen es a propósito.
# Truncar no se reintenta (la misma petición se corta igual y cuesta dinero otra
# vez), así que quedarse corto aquí es un fallo definitivo, no un reintento.
LLM_MAX_TOKENS=32000

# Tope de duración TOTAL de la llamada, de reloj. Cinco generaciones medidas de
# deepseek-v4-pro tardaron 118, 146, 150 y 174 s, así que con 120 fallaban dos de
# cada tres. Ojo: NO es el `timeout` de requests, que solo acota el silencio
# entre bytes y dejó una llamada abierta 8 minutos; el tope real lo pone el
# worker mirando el reloj mientras descarga (llm/openrouter.py).
LLM_TIMEOUT_SECONDS=300

# Cuánto se le deja improvisar: 0 = siempre la misma respuesta, 1 = muy creativo.
# Es la palanca de producto para que las recetas no salgan todas iguales.
LLM_TEMPERATURE=0.6

# ---------- Ajustes con valor por defecto en el código ----------
# Estos NO se pasan en el compose porque no los toco a diario. Los dejo anotados
# para saber que existen; para usar uno hay que añadirlo también al servicio:
#   JOB_MAX_ATTEMPTS (3), JOB_RETRY_BACKOFF_SECONDS (2),
#   JOB_RETRY_BACKOFF_MAX_SECONDS (60)  → reintentos y espera creciente
#   LLM_API_URL       → apuntar a otro endpoint: un servidor falso para ensayar
#                       fallos, o un proxy propio si algún día quiero un gateway
#                       de modelos dentro de mi infraestructura
#   LLM_STUB_LATENCY_SECONDS → hacer que el stub tarde, para ver la cola llena
#   LOG_LEVEL (INFO)  → subir a DEBUG cuando algo no cuadra
